{
  "sourceLanguage": "en",
  "strings": {
    "Band not found. Keep it close to the phone and make sure it is charged.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brățara nu a fost găsită. Ține-o aproape de telefon și asigură-te că e încărcată."
          }
        }
      }
    },
    "Bluetooth access is not allowed. Enable it in Settings > Pulse Bridge.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la Bluetooth nu este permis. Activează-l în Configurări > Pulse Bridge."
          }
        }
      }
    },
    "Bluetooth is not available on this device.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth nu este disponibil pe acest dispozitiv."
          }
        }
      }
    },
    "Bluetooth is off. Turn it on in Control Center.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth este oprit. Pornește-l din Centrul de control."
          }
        }
      }
    },
    "No band paired yet.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio brățară asociată încă."
          }
        }
      }
    },
    "The band stopped responding.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brățara nu mai răspunde."
          }
        }
      }
    },
    "This iPhone no longer knows the band. Use Forget band, then pair it again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest iPhone nu mai recunoaște brățara. Folosește Uită brățara, apoi asociaz-o din nou."
          }
        }
      }
    },
    "Unknown band": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Brățară necunoscută"
          }
        }
      }
    }
  },
  "version": "1.0"
}
