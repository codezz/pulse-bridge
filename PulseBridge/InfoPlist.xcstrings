{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge"
          }
        }
      },
      "shouldTranslate": false
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge connects to your Pulse band to read your activity and health history."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge se conectează la brățara Pulse pentru a citi istoricul activității și al sănătății."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge does not read your Health data."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge nu citește datele tale din Sănătate."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge writes steps, distance, heart rate, HRV, blood oxygen, sleep and workouts from your band to Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge scrie în Sănătate pașii, distanța, ritmul cardiac, HRV, oxigenul din sânge, somnul și antrenamentele de la brățară."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge records your route, distance and pace while an activity you started is running."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Bridge înregistrează traseul, distanța și ritmul cât timp rulează o activitate pornită de tine."
          }
        }
      }
    }
  },
  "version": "1.0"
}
